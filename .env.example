# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=phoenixwebhost.com

# AI receptionist uses Vercel OIDC on deploy (VERCEL_OIDC_TOKEN).
# Do not set XAI_API_KEY or AI_GATEWAY_API_KEY.

# Owner login (Alex Ochoa). AUTH_SECRET must be a long random string in production.
# 2FA code is emailed/texted only when RESEND_API_KEY and/or Twilio vars are set.
ADMIN_EMAIL=alex@phoenixwebhost.com
ADMIN_PASSWORD=MesaSunrise2026!
AUTH_SECRET=replace-with-a-long-random-string

# Stripe test mode (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SETUP_PRICE_ID=price_...
STRIPE_MONTHLY_PRICE_ID=price_...
# Optional Local Boost add-on ($99 once + $79/month). Already created in Stripe test mode.
STRIPE_BOOST_SETUP_PRICE_ID=price_...
STRIPE_BOOST_MONTHLY_PRICE_ID=price_...
# Optional Traffic ads add-on ($199/month only, no setup fee). Create the Stripe Price, then set the ID.
# Production still needs the live Price ID on Vercel. Do not invent a fake live key.
STRIPE_TRAFFIC_MONTHLY_PRICE_ID=price_...
# Optional Loud ads add-on ($349/month only, no setup fee). Create the Stripe Price, then set the ID.
# Production still needs the live Price ID on Vercel. Do not invent a fake live key.
STRIPE_LOUD_MONTHLY_PRICE_ID=price_...
# Optional Business Email add-on ($49 once + $19/month). Already created in Stripe test mode.
STRIPE_EMAIL_SETUP_PRICE_ID=price_...
STRIPE_EMAIL_MONTHLY_PRICE_ID=price_...
# Optional Book a job add-on ($49 once + $19/month). Create the Stripe Prices, then set the IDs.
# Production still needs the live Price IDs on Vercel. Do not invent fake live keys.
STRIPE_BOOK_SETUP_PRICE_ID=price_...
STRIPE_BOOK_MONTHLY_PRICE_ID=price_...
# Optional Missed-call text-back ($49 once + $29/month). Sell only — not wired to Twilio.
STRIPE_MISSED_SETUP_PRICE_ID=price_...
STRIPE_MISSED_MONTHLY_PRICE_ID=price_...
# Optional Review texts ($29/month). Sell only — does not replace Local Boost.
STRIPE_REVIEW_MONTHLY_PRICE_ID=price_...
# Optional Voice receptionist ($99 once + $79/month). Sell only — not the included chat.
STRIPE_VOICE_SETUP_PRICE_ID=price_...
STRIPE_VOICE_MONTHLY_PRICE_ID=price_...
# Optional domain register (~$20 first-year .com). Create the Stripe Price, then set the ID.
# Production still needs the live Price ID on Vercel. Do not invent a fake live key.
STRIPE_DOMAIN_YEARLY_PRICE_ID=price_...

# Production persistence on Vercel (Neon or any Postgres)
# DATABASE_URL=postgres://...

# Optional: protect the daily unpaid-policy cron
# CRON_SECRET=replace-me

# Owner alerts when someone requests a site or leaves a review (email + SMS).
# Defaults below; override if needed. Do not put API keys in git.
NOTIFY_EMAIL=ochoa.alejandro2@gmail.com
NOTIFY_PHONE=+14809532393

# Email via Resend — skip email if RESEND_API_KEY is unset
RESEND_API_KEY=
# RESEND_FROM=Phoenixwebhost Inc. <onboarding@resend.dev>

# SMS via Twilio REST API — skip SMS if any of these are unset
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Vercel Blob — private files for tax-office uploads and Admin → Sign a PDF
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Hola Tax Service staff bootstrap (Alex’s tax shop only). Separate from ADMIN_PASSWORD.
# Other tax-office clients set staff email/password in Admin → client.
HOLA_TAX_STAFF_EMAIL=ochoa.alejandro2@gmail.com
# HOLA_TAX_STAFF_PASSWORD=
